# Copy to .dev.vars and fill in. .dev.vars is gitignored — never commit real values.
# Get the Spotify values from tools/spotify-auth.mjs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Shared by the queue and note form.
TURNSTILE_SECRET=
# Existing Discord incoming webhook used by the note form.
DISCORD_WEBHOOK_URL=
